---
interface Props { items: { question: string; answer: string }[]; schema?: boolean; }
const { items, schema = true } = Astro.props;
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) };
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary>{f.question}<span class="plus" aria-hidden="true">+</span></summary>
      <p class="ans">{f.answer}</p>
    </details>
  ))}
</div>
{schema && items.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
