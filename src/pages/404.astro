---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | FV Funding" noindex>
  <section class="bg-dark relative">
    <div class="glow glow-tr" aria-hidden="true"></div>
    <div class="wrap section" style="position:relative;min-height:50vh">
      <p class="eyebrow">404</p>
      <h1 class="h1">This page <span class="grad-text">isn’t here.</span></h1>
      <p class="lead mt-24">It may have moved. These will get you back on track.</p>
      <div class="btn-row mt-32"><a class="btn btn-grad btn-lg" href="/">Go to the homepage</a><a class="btn btn-ghost-dark btn-lg" href="/services/">See services</a></div>
    </div>
  </section>
</Base>
